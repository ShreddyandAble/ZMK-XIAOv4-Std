#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        VPCS202011: VPCS202011 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(V) &kp LS(P) &kp LS(C) &kp LS(S) &kp N2 &kp N0 &kp N2 &kp N0 &kp EXCL &kp EXCL &kp RET>;
            label = "VPCS202011";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt LEFT_SHIFT EQUAL  &kp N1  &kp N2  &kp N3         &kp N4        &kp N5           &kp N6                    &kp N7       &kp N8      &kp N9   &kp N9     &mt LEFT_SHIFT N0
&kp CAPSLOCK          &kp Q   &kp W   &kp E          &kp R         &kp T            &kp Y                     &kp U        &kp I       &kp O    &kp P      &kp RG(PERIOD)
&mkp LCLK             &kp A   &kp S   &kp D          &kp F         &kp G            &kp H                     &kp J        &kp K       &kp L    &kp COLON  &kp SQT
&mt LCTRL TILDE       &kp Z   &kp X   &kp C          &kp V         &kp B            &kp N                     &kp M        &kp COMMA   &kp DOT  &kp FSLH   &mt RCTRL LS(LG(S))
                                      &kp BACKSPACE  &lt 1 ENTER   &mt LCTRL TAB    &mt LEFT_SHIFT BACKSPACE  &lt 2 SPACE  &kp DELETE
                                      &kp RA(LEFT)   &kp UP_ARROW  &kp DOWN         &kp LEFT                  &kp RIGHT    &kp ESCAPE
            >;
        };

        Numbers {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans         &trans     &trans         &trans        &kp NUMBER_9          &trans                 &trans
&trans      &trans           &trans        &trans        &trans        &trans         &trans     &trans         &trans        &trans                &trans                 &trans
&kp PLUS    &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&trans      &trans           &trans        &trans        &kp MINUS     &trans         &trans     &trans         &trans        &trans                &trans                 &trans
                                           &trans        &trans        &trans         &trans     &trans         &trans
                                           &trans        &trans        &trans         &trans     &trans         &trans
            >;
        };

        Arrows {
            bindings = <
&trans  &trans  &kp K_PREV              &kp K_NEXT       &kp K_PLAY_PAUSE   &trans         &trans       &trans           &trans        &trans     &trans  &trans
&trans  &trans  &kp RG(LEFT_ARROW)      &kp RG(D)        &kp RG(RIGHT)      &trans         &trans       &kp HOME         &kp UP_ARROW  &kp END    &trans  &trans
&trans  &trans  &kp RC(RG(LEFT_ARROW))  &kp RG(TAB)      &kp RC(RG(RIGHT))  &VPCS202011    &trans       &kp LEFT         &kp DOWN      &kp RIGHT  &trans  &trans
&trans  &trans  &kp K_VOLUME_DOWN       &kp K_VOLUME_UP  &kp K_MUTE         &trans         &kp DEL      &kp RS(RC(TAB))  &kp LC(TAB)   &trans     &trans  &trans
                                        &trans           &kp PG_UP          &kp PG_DN      &bootloader  &trans           &trans
                                        &trans           &trans             &trans         &trans       &trans           &trans
            >;
        };
    };
};

