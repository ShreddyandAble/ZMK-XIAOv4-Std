#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        VPCS202011: VPCS202011 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(V) &kp LS(P) &kp LS(C) &kp LS(S) &kp N2 &kp N0 &kp N2 &kp N0 &kp EXCL &kp EXCL &kp RET>;
            label = "VPCS202011";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt LEFT_SHIFT EQUAL     &kp N1  &kp N2  &kp N3         &kp N4        &kp N5            &kp N6                    &kp N7       &kp N8        &kp N9   &kp N0     &mt LEFT_SHIFT MINUS
&mkp LCLK                &kp Q   &kp W   &kp E          &kp R         &kp T             &kp Y                     &kp U        &kp I         &kp O    &kp P      &kp TILDE
&mt LEFT_SHIFT CAPSLOCK  &kp A   &kp S   &kp D          &kp F         &kp G             &kp H                     &kp J        &kp K         &kp L    &kp COLON  &kp SQT
&mt LCTRL RG(PERIOD)     &kp Z   &kp X   &kp C          &kp V         &kp B             &kp N                     &kp M        &kp COMMA     &kp DOT  &kp FSLH   &mt RCTRL LS(LG(S))
                                         &kp BACKSPACE  &lt 1 ENTER   &mt LCTRL TAB     &mt LEFT_SHIFT BACKSPACE  &lt 2 SPACE  &kp DELETE
                                         &kp ESCAPE     &kp UP_ARROW  &kp DOWN_ARROW    &kp LEFT_ARROW            &kp RIGHT    &kp RA(LEFT)
            >;
        };

        Numbers {
            bindings = <
&none     &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT    &trans     &trans         &trans        &trans                &trans                 &trans
&none     &trans           &trans       &trans    &trans      &trans         &trans     &trans         &trans        &trans                &trans                 &trans
&kp PLUS  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&trans    &trans           &trans       &trans    &kp MINUS   &trans         &trans     &trans         &trans        &trans                &trans                 &trans
                                        &trans    &trans      &trans         &trans     &trans         &trans
                                        &trans    &trans      &trans         &none      &trans         &trans
            >;
        };

        Arrows {
            bindings = <
&trans  &none  &kp C_PREVIOUS          &kp C_NEXT       &kp C_PLAY_PAUSE   &none          &trans   &none            &none         &none         &none               &trans
&trans  &none  &kp RG(LEFT_ARROW)      &kp RG(D)        &kp RG(RIGHT)      &none          &none    &kp HOME         &kp UP_ARROW  &kp END       &none               &trans
&trans  &none  &kp RC(RG(LEFT_ARROW))  &kp RG(TAB)      &kp RC(RG(RIGHT))  &VPCS202011    &none    &kp LEFT         &kp DOWN      &kp RIGHT     &none               &trans
&trans  &none  &kp C_VOL_DN            &kp C_VOLUME_UP  &kp C_MUTE         &none          &kp DEL  &kp RS(RC(TAB))  &kp LC(TAB)   &kp RA(LEFT)  &kp RA(LEFT_ARROW)  &kp RA(LEFT_ARROW)
                                       &trans           &kp PG_UP          &kp PG_DN      &trans   &trans           &trans
                                       &trans           &trans             &trans         &trans   &trans           &trans
            >;
        };
    };
};

